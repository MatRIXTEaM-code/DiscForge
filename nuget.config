<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Exactly one deterministic feed: nuget.org. The bare <clear /> of the offline-build era
         left CI runners (which have no local package cache) with no source at all. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
