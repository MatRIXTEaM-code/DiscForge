# Build output
bin/
obj/
publish/
dist/
installer/Output/

# Built binaries should never be committed - CI rebuilds them from source.
*.exe

# Visual Studio / Rider
.vs/
.idea/
*.user
*.suo

# Test results
TestResults/
*.trx

# Disc images and dumps — large, and reproducible from the media.
# Test fixtures are deliberately exempt below: the suite needs them.
*.cdi
*.iso
*.bin
*.img
*.sub
*.cue
*.mds
*.mdf

# …except the checked-in fixtures the tests depend on.
!tests/fixtures/**

# Diagnostics
discforge-diagnostics-*.txt

# Licence signing material — NEVER commit the private key or issued keys.
keys/
*.pem
*.key
!tests/**            # (fixtures under tests/ stay tracked)
PS1/
discforge_sync/
errors.txt

PS1/
discforge_sync/
errors.txt

PS1/
discforge_sync/
errors.txt
*.badsectors.json
plextor-profile.json
cdextra.dfp.json

PS1/
discforge_sync/
errors.txt
*.badsectors.json
plextor-profile.json
cdextra.dfp.json
*.subq

# hw-test-resume*.ps1 scratch output — regenerated by every run, not source. (resume-fixture.cue,
# resume-golden.img, a-big.bin, data.bin are already covered by the *.cue/*.img/*.bin rules above;
# bigtest.cdi's sidecars need an explicit entry since *.cdi alone doesn't match a compound
# extension like bigtest.cdi.pass1.log or bigtest.cdi.ripstate.json.)
bigtest.cdi*
build-logs/
